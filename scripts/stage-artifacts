#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="$ROOT_DIR/versions.json"
ARTIFACT_DIR="$ROOT_DIR/artifacts"

mkdir -p "$ARTIFACT_DIR"

while IFS='|' read -r name version url expected_sha; do
  destination="$ARTIFACT_DIR/${name}-${version}"
  if [[ ! -f "$destination" ]]; then
    echo "[dwlle] Downloading $name $version"
    curl -fL --retry 3 -o "$destination" "$url"
  fi

  actual_sha="$(shasum -a 256 "$destination" | cut -d ' ' -f1)"
  if [[ "$actual_sha" != "$expected_sha" ]]; then
    echo "[dwlle] SHA256 mismatch for $name $version" >&2
    rm -f "$destination"
    exit 1
  fi
  echo "[dwlle] Verified $name $version"
done < <(python3 -c 'import json; data=json.load(open("versions.json")); [print("|".join([item["name"], item["version"], item["url"], item["sha256"]])) for item in data["artifacts"]]')
