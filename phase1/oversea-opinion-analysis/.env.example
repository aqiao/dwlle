# Kafka
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=raw_content

# StarRocks(Stream Load 直连 BE 8040;SQL 查询走 FE 9030)
SR_BE_HTTP=http://localhost:8040
SR_FE_HOST=localhost
SR_FE_PORT=9030
SR_DB=opinion
SR_USER=root
SR_PASSWORD=

# AWS Bedrock(LLM 分析)
AWS_REGION=us-east-1
# Kimi 在 Bedrock 上的 model ID,以控制台实际可用值为准
BEDROCK_MODEL_ID=moonshot.kimi-k2-thinking
# 如不使用实例角色,取消下面两行的注释
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# 分析参数
ANALYZE_BATCH_SIZE=50
ANALYZE_LOOKBACK_DAYS=3

# 日报输出目录
REPORT_DIR=reports

# 海外网站代理:服务器在海外可留空;在国内必须配置,否则采集会超时
# 对 requests(抓正文)和 feedparser(拉 RSS)同时生效
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
